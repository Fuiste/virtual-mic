<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/VirtualMic.PluginApi/VirtualMic.PluginApi.csproj" Private="false" ExcludeAssets="runtime" />
    <!-- Use only the pinned native APM, not SoundFlow's audio engine or managed wrapper. -->
    <PackageDownload Include="SoundFlow.Extensions.WebRtc.Apm" Version="[1.4.0]" />
    <None Include="$(NuGetPackageRoot)/soundflow.extensions.webrtc.apm/1.4.0/runtimes/win-x64/native/webrtc-apm.dll" Link="webrtc-apm.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="VerifyNativeApm" BeforeTargets="BeforeBuild">
    <GetFileHash Files="$(NuGetPackageRoot)/soundflow.extensions.webrtc.apm/1.4.0/runtimes/win-x64/native/webrtc-apm.dll" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="ApmNativeHash" />
    </GetFileHash>
    <Error Condition="'$(ApmNativeHash)' != '89AB213150E0A3F7D0CA6424EF8F72E2402ADABCFAE8A369976B8B27DF207411'" Text="Pinned WebRTC native binary checksum differs; review dependency provenance before updating." />
  </Target>
</Project>
