<Window x:Class="VirtualMic.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VirtualMic.App"
        Title="virtual mic" Width="1180" Height="820" MinWidth="960" MinHeight="740" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="FilesDropped" PreviewKeyDown="WindowKeyDown" Closing="WindowClosing">
  <Grid x:Name="Root" Margin="28,18,28,16" Background="{StaticResource Bg}">
    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <Border VerticalAlignment="Top">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M0,0 L14,0 14,10 9,15 0,15Z" Fill="{StaticResource Accent}" Width="14" Height="15" Margin="0,0,12,0"/><TextBlock Text="virtual mic" FontSize="20" FontWeight="SemiBold"/></StackPanel>
        <Border DockPanel.Dock="Right" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="12,8"><StackPanel Orientation="Horizontal"><Ellipse x:Name="LiveDot" Fill="{StaticResource Muted}" Width="6" Height="6" Margin="0,0,8,0"/><TextBlock x:Name="LiveText" Text="stopped" Style="{StaticResource Label}"/></StackPanel></Border>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="32"/><RowDefinition Height="272"/></Grid.RowDefinitions>
        <DockPanel LastChildFill="False" VerticalAlignment="Top">
          <TextBlock Text="sounds" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Content="+ add sounds" Click="AddSounds" Background="{StaticResource Accent}" Foreground="#151917" BorderBrush="{StaticResource Accent}" Padding="14,8" Margin="8,0,0,0" AutomationProperties.Name="add sound files"/>
          <Button x:Name="StopSoundsButton" DockPanel.Dock="Right" Content="stop sounds" Click="StopSounds" ToolTip="stop every sound pad (esc). microphone stays live." Padding="12,8"/>
        </DockPanel>
        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="5" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12">
          <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="PadList" ItemsSource="{Binding Pads}" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Click="PadClicked" Tag="{Binding}" Height="112" Margin="5" Padding="13,10" HorizontalContentAlignment="Stretch" Background="#202722" ToolTip="play / retrigger · right-click to rename or remove" AutomationProperties.Name="{Binding Name}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Green}"/><Setter Property="Background" Value="#2b3627"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    <Button.ContextMenu><ContextMenu><MenuItem Header="rename sound" Click="RenamePad"/><MenuItem Header="remove from library" Click="RemovePad"/></ContextMenu></Button.ContextMenu>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="*"/><RowDefinition Height="19"/></Grid.RowDefinitions>
                      <TextBlock Text="{Binding IndexLabel}" Style="{StaticResource Label}" Foreground="{Binding Color}"/>
                      <TextBlock Text="▶" Foreground="{Binding Color}" HorizontalAlignment="Right" FontSize="12"/>
                      <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Row="2" Text="{Binding DurationLabel}" Style="{StaticResource Label}"/>
                      <TextBlock Grid.Row="2" Text="{Binding StateLabel}" Foreground="{Binding Color}" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="10"/>
                    </Grid>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="EmptyLibrary" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="drop audio files here" FontSize="16" HorizontalAlignment="Center"/>
              <TextBlock Text="wav, mp3, aiff" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,18" HorizontalAlignment="Center"/>
              <Button Content="add sample sounds" Click="AddStarterSounds" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Border>
        <DockPanel Grid.Row="2" Margin="3,8,3,0" LastChildFill="False"><TextBlock x:Name="LibraryCount" Text="0 / 24 sounds" Style="{StaticResource Label}"/><TextBlock DockPanel.Dock="Right" Text="1–9: play · esc: stop" Style="{StaticResource Label}" ToolTip="shortcuts work while this window is focused"/></DockPanel>
        <local:EffectEditor x:Name="EffectsEditor" Grid.Row="3"/>
      </Grid>
      <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="20,0,0,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <DockPanel LastChildFill="False" Margin="0,0,0,14"><TextBlock Text="audio devices" Style="{StaticResource Heading}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="↻" Click="RefreshClicked" Padding="9,4" ToolTip="refresh devices; stop audio first" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="refresh audio devices"/></DockPanel>
          <TextBlock Text="microphone" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,0,0,6"/>
          <ComboBox x:Name="Microphone" DisplayMemberPath="Name" SelectionChanged="DeviceChanged" AutomationProperties.Name="microphone input"/>
          <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions><DockPanel LastChildFill="False"><TextBlock Text="gain" Style="{StaticResource Label}"/><TextBlock x:Name="MicValue" DockPanel.Dock="Right" Text="100%" Style="{StaticResource Label}" Margin="0,0,10,0"/></DockPanel><CheckBox Grid.Column="1" x:Name="MuteMic" Content="mute" HorizontalAlignment="Right" Checked="ControlsChanged" Unchecked="ControlsChanged"/></Grid>
          <Slider x:Name="MicVolume" Value="100" Maximum="200" ValueChanged="SliderChanged" AutomationProperties.Name="microphone gain"/>
          <ProgressBar x:Name="MicMeter" Margin="0,2,0,17"/>
          <TextBlock Text="virtual output" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,0,0,6"/>
          <ComboBox x:Name="VirtualOutput" DisplayMemberPath="Name" SelectionChanged="DeviceChanged" AutomationProperties.Name="virtual cable output"/>
          <TextBlock x:Name="RouteHint" Text="call app microphone: cable output" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,12"/>
          <Button x:Name="CableHelp" Content="install vb-cable ↗" Visibility="Collapsed" Click="OpenCableHelp" HorizontalAlignment="Left" Padding="0,2" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="sounds" Style="{StaticResource Label}"/><TextBlock x:Name="SoundValue" DockPanel.Dock="Right" Text="70%" Style="{StaticResource Label}"/></DockPanel><Slider x:Name="SoundVolume" Value="70" Maximum="150" ValueChanged="SliderChanged" AutomationProperties.Name="soundboard volume"/></StackPanel><StackPanel Grid.Column="2"><DockPanel LastChildFill="False"><TextBlock Text="master" Style="{StaticResource Label}"/><TextBlock x:Name="MasterValue" DockPanel.Dock="Right" Text="80%" Style="{StaticResource Label}"/></DockPanel><Slider x:Name="MasterVolume" Value="80" ValueChanged="SliderChanged" AutomationProperties.Name="master output volume"/></StackPanel></Grid>
          <ProgressBar x:Name="OutputMeter" Margin="0,3,0,5"/>
          <DockPanel LastChildFill="False"><TextBlock x:Name="LevelText" Text="−∞ dbfs" Style="{StaticResource Label}" ToolTip="virtual output level"/><TextBlock x:Name="LimitText" DockPanel.Dock="Right" Style="{StaticResource Label}" FontSize="10"/></DockPanel>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
            <StackPanel>
              <DockPanel Margin="0,0,0,9"><TextBlock Text="monitor" Foreground="{StaticResource Accent}" FontSize="12"/><CheckBox x:Name="MonitorToggle" Content="listen" HorizontalAlignment="Right" Checked="ControlsChanged" Unchecked="ControlsChanged"/></DockPanel>
              <ComboBox x:Name="MonitorOutput" DisplayMemberPath="Name" SelectionChanged="DeviceChanged" AutomationProperties.Name="headphone monitor device"/>
              <DockPanel LastChildFill="False" Margin="0,10,0,0"><TextBlock Text="volume" Style="{StaticResource Label}"/><TextBlock x:Name="MonitorValue" DockPanel.Dock="Right" Text="50%" Style="{StaticResource Label}"/></DockPanel>
              <Slider x:Name="MonitorVolume" Value="50" ValueChanged="SliderChanged" AutomationProperties.Name="headphone monitor volume"/>
              <CheckBox x:Name="HearMic" Content="hear microphone" Checked="ControlsChanged" Unchecked="ControlsChanged" Margin="0,5,0,0" ToolTip="include your voice in the monitor; use headphones to avoid feedback"/>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1">
          <Button x:Name="PowerButton" Content="start virtual mic" Click="ToggleEngine" Background="{StaticResource Green}" Foreground="#151917" BorderBrush="{StaticResource Green}" Padding="14,13" Margin="0,16,0,0" HorizontalContentAlignment="Center"/>
          <TextBlock x:Name="EngineHint" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,10,0,0"/>
        </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,8,0,0"><TextBlock x:Name="Status" Text="select devices, then start virtual mic." Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></Border>
  </Grid>
</Window>
